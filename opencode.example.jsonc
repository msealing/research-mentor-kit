{
  "$schema": "https://opencode.ai/config.json",
  // 复制本文件为 opencode.jsonc 并根据你的环境修改路径/密钥
  // V2 插件配置：plugins 数组（对象形态），本地插件放到 ~/.config/opencode/plugins/ 或本仓库 plugins/
  "plugins": [
    {
      "package": "./plugins/vision.ts"
    }
  ],
  "mcp": {
    "servers": {
      "paper-search-mcp": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "--with",
          "paper-search-mcp",
          "python",
          "-m",
          "paper_search_mcp.server"
        ],
        "environment": {
          "PAPER_SEARCH_MCP_ENV_FILE": "C:\\Users\\<用户名>\\.config\\paper-search-mcp\\.env"
        }
      },
      "cnki-mcp": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "cd /d <你的仓库路径>\\mcp\\cnki-mcp && .venv\\Scripts\\python.exe -m cnki_mcp.server"
        ]
      }
    },
    "timeout": {
      "catalog": 90000,
      "execution": 90000
    }
  }
}