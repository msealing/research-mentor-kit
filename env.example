# Paper Search MCP 环境变量模板
# 复制本文件为 .env 并填入你自己的密钥：
#   cp env.example .env
# 然后在 opencode 配置中将 PAPER_SEARCH_MCP_ENV_FILE 指向该文件。

# 用于访问 Unpaywall 开放获取文献的邮箱（必填，Unpaywall 要求提供邮箱）
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=

# CORE.ac.uk API Key（可选，用于加强检索覆盖）
# 申请: https://core.ac.uk/services/api
CORE_API_KEY=

# Semantic Scholar API Key（可选）
# 申请: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Google Scholar 代理 URL（可选，用于绕过 Google Scholar 反爬）
GOOGLE_SCHOLAR_PROXY_URL=

# DOAJ API Key（可选）
# 申请: https://doaj.org/account
DOAJ_API_KEY=

# Zenodo API Token（可选）
# 申请: https://zenodo.org/account/settings/applications/
ZENODO_ACCESS_TOKEN=

# IEEE Xplore API Key（可选）
# 申请: https://developer.ieee.org/
IEEE_API_KEY=

# ACM Digital Library API Key（可选）
# 申请: https://libraries.acm.org/acm-digital-library/api
ACM_API_KEY=